<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Celengan Digital"
                android:textColor="#94A3B8"
                android:textSize="9.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="Belum Nabung"
            android:textColor="#F59E0B"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#334155" />

    <!-- Goal Details -->
    <TextView
        android:id="@+id/tv_widget_goal_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Celengan Utama"
        android:textColor="#F1F5F9"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_widget_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Rp 0 / Rp 1.000.000 (0%)"
        android:textColor="#93C5FD"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/pb_widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/tv_widget_estimate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Estimasi: 30 hari lagi"
        android:textColor="#94A3B8"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/tv_widget_large_tip"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Sisihkan tabungan setiap hari untuk mempercepat tercapainya impian Anda."
        android:textColor="#64748B"
        android:textSize="9.5sp" />

    <!-- 1-Tap Action Button -->
    <Button
        android:id="@+id/btn_widget_save"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_button"
        android:text="⚡ Setor Target Harian"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="11.5sp"
        android:textStyle="bold" />

</LinearLayout>
